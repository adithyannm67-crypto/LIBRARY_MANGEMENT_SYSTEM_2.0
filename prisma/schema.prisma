generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model books {
  id              String   @id
  title           String
  author          String
  isbn            String
  category        String
  subcategory     String
  description     String
  coverColor      String
  coverAccent     String
  publisher       String
  publishedYear   Int
  pages           Int
  language        String
  rating          Decimal  @db.Decimal(3, 1)
  reviewCount     Int
  totalCopies     Int
  availableCopies Int
  borrowedCopies  Int
  reservations    Int
  totalBorrows    Int
  status          String
  tags            String[]
  isBestseller    Boolean? @default(false)
  addedAt         DateTime @db.Timestamptz(6)
  isNew           Boolean? @default(false)
}
